    {
      "parameters": {
        "jsCode": "// Extract sync request\nconst action = $input.item.json.body.action;\nconst source = $input.item.json.body.source;\nconst target = $input.item.json.body.target;\nconst data = $input.item.json.body.data;\nconst syncType = $input.item.json.body.syncType || 'bidirectional';\n\n// Validate HMAC signature\nconst crypto = require('crypto');\nconst receivedSignature = $input.item.json.headers['x-webhook-secret'];\nconst webhookSecret = $env.N8N_WEBHOOK_SECRET;\nconst payload = JSON.stringify($input.item.json.body);\nconst expectedSignature = crypto.createHmac('sha256', webhookSecret).update(payload).digest('hex');\n\nif (receivedSignature !== expectedSignature) {\n  throw new Error('Invalid webhook signature');\n}\n\nreturn {\n  action,\n  source,\n  target,\n  data,\n  syncType,\n  timestamp: new Date().toISOString()\n};"
      },
