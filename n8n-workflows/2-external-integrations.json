    {
      "parameters": {
        "jsCode": "// Transform data based on target\nconst sourceData = $input.item.json;\nconst target = $input.item.json.target;\nconst source = $input.item.json.source;\n\nlet transformedData = {};\n\n// Productboard → Airtable\nif (source === 'productboard' && target === 'airtable') {\n  transformedData = {\n    Name: sourceData.name,\n    Description: sourceData.description,\n    Status: sourceData.status,\n    Priority: sourceData.priority,\n    ProductboardId: sourceData.id,\n    LastSync: new Date().toISOString()\n  };\n}\n\n// Airtable → GitHub\nelse if (source === 'airtable' && target === 'github') {\n  transformedData = {\n    title: sourceData.fields.Name,\n    body: sourceData.fields.Description,\n    labels: [sourceData.fields.Status, sourceData.fields.Priority],\n    assignees: sourceData.fields.Assignees || []\n  };\n}\n\n// GitHub → Supabase\nelse if (source === 'github' && target === 'supabase') {\n  transformedData = {\n    title: sourceData.title,\n    description: sourceData.body,\n    status: sourceData.state,\n    github_issue_number: sourceData.number,\n    github_url: sourceData.html_url,\n    created_at: sourceData.created_at,\n    updated_at: sourceData.updated_at\n  };\n}\n\n// Supabase → Productboard\nelse if (source === 'supabase' && target === 'productboard') {\n  transformedData = {\n    name: sourceData.title,\n    description: sourceData.description,\n    status: sourceData.status,\n    customFields: {\n      supabase_id: sourceData.id\n    }\n  };\n}\n\nreturn {\n  source,\n  target,\n  originalData: sourceData,\n  transformedData,\n  timestamp: new Date().toISOString()\n};"
      },
