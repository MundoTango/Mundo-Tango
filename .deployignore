# Deployment Ignore File - Exclude non-runtime files from deployment image
# This reduces the deployment image size to stay under Replit's 8 GiB limit

# ==========================================
# NODE_MODULES (Replit rebuilds in deployment)
# ==========================================
node_modules/

# ==========================================
# LARGE DATA DIRECTORIES (4.2 GB+)
# ==========================================
lancedb_data/
.cache/
.npm/
.pnpm-store/
.local/
.replit/
.upm/

# ==========================================
# PLAYWRIGHT BROWSERS (600MB+)
# ==========================================
.cache/ms-playwright/

# ==========================================
# TEST ARTIFACTS
# ==========================================
test-videos/
test-results/
tests/
e2e/
playwright-report/
playwright.config.ts
*.spec.ts

# ==========================================
# DEVELOPMENT/BUILD ASSETS
# ==========================================
attached_assets/
docs/
reports/
qa_reports/
logs/

# ==========================================
# CLIENT SOURCE CODE (already bundled in dist/)
# ==========================================
client/
# NOTE: server/ is NOT excluded - it's needed for Express runtime

# ==========================================
# DEVELOPMENT FILES
# ==========================================
*.md
*.log
*.png
*.jpg
*.jpeg
!dist/**/*.png
!dist/**/*.jpg
!dist/**/*.jpeg

# ==========================================
# CONFIG/DEVELOPMENT FILES
# ==========================================
.husky/
.git/
.mcp/
.config/
agent-memory/
bifrost-config/
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# MISC DEVELOPMENT FILES
# ==========================================
drizzle.config.ts
tailwind.config.ts
postcss.config.js
tsconfig.json
eslint.config.js
commitlint.config.js
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
vitest.config.ts

# ==========================================
# TEMPORARY/CACHE FILES
# ==========================================
*.tmp
*.temp
.cache/
tmp/

# ==========================================
# SCRIPTS (not needed at runtime)
# ==========================================
scripts/

