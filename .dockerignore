# ==========================================
# MB.MD Pattern 52 - Deployment Size Optimization
# Replit uses .dockerignore for deployment exclusions
# ==========================================

# ==========================================
# LARGE DATA DIRECTORIES (4.5+ GB savings)
# ==========================================
lancedb_data/
attached_assets/
test-videos/

# ==========================================
# DOCUMENTATION & DEVELOPMENT
# ==========================================
docs/
e2e/
tests/
scripts/
qa_reports/
reports/
agent-memory/
bifrost-config/

# ==========================================
# SOURCE CODE (bundled in dist/)
# ==========================================
client/
server/
shared/

# ==========================================
# TEST ARTIFACTS
# ==========================================
test-results/
playwright-report/
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
vitest.config.ts
playwright.config.ts

# ==========================================
# VERSION CONTROL & CONFIG
# ==========================================
.git/
.github/
.gitignore
.gitattributes
.mcp/
.config/
.local/
.upm/
.husky/
.gitlab-ci.yml
.circleci/

# ==========================================
# ENVIRONMENT FILES
# ==========================================
.env
.env.local
.env.*.local
.env.example

# ==========================================
# BUILD/CONFIG FILES (not needed at runtime)
# ==========================================
drizzle.config.ts
tailwind.config.ts
postcss.config.js
tsconfig.json
eslint.config.js
commitlint.config.js

# ==========================================
# IDE
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# OS
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# LOGS
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# DOCUMENTATION
# ==========================================
*.md
!README.md

# ==========================================
# DATABASE LOCAL FILES
# ==========================================
*.sqlite
*.db
db/

# ==========================================
# TEMPORARY/CACHE
# ==========================================
tmp/
temp/
*.tmp
*.temp
.cache/
node_modules/.cache/
node_modules/.vite/

# ==========================================
# IMAGES/SCREENSHOTS AT ROOT
# ==========================================
*.png
*.jpg
*.jpeg
patterns_for_import.json
