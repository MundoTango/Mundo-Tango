# ===========================================
# DOCKER IGNORE FILE - Reduce deployment image to under 8 GiB
# Replit runs `npm run build` INSIDE Docker, so keep source files
# ===========================================

# ==========================================
# CRITICAL: LARGE DATA DIRECTORIES (7+ GB total)
# These are the main contributors to image size
# ==========================================
lancedb_data/
attached_assets/*
!attached_assets/stock_images/
!attached_assets/optimized/
.local/
.cache/
.npm/
.pnpm-store/
.replit/
.upm/
node_modules/

# ==========================================
# GIT HISTORY (1.6+ GB)
# ==========================================
.git/

# ==========================================
# TEST ARTIFACTS & E2E (34+ MB)
# ==========================================
test-videos/
test-results/
tests/
e2e/
playwright-report/
playwright.config.ts
*.spec.ts
*.spec.tsx
*.test.ts
*.test.tsx
vitest.config.ts
cypress/
jest/
.jest/
__mocks__/
__tests__/

# ==========================================
# DOCUMENTATION & REPORTS (20+ MB)
# ==========================================
docs/
reports/
qa_reports/
agent-reports/
lighthouse-reports/
bundle-analysis/
mr-blue-brain/
mb-legacy.md

# ==========================================
# DEV CONFIG FILES (not needed for build or runtime)
# ==========================================
.husky/
.mcp/
.config/
.vscode/
.idea/
agent-memory/
bifrost-config/

# ==========================================
# LOGS & TEMP FILES
# ==========================================
logs/
*.log
*.tmp
*.temp
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# SCREENSHOTS & IMAGES (dev artifacts)
# ==========================================
topbar-check.png
after_toast_clear.png
feed_page.png
feed-3-column-layout.png
homepage_after_login.png
memories-3-column-layout.png
3-column-spacing.png
events-3-column-layout.png
events-page.png
events-page-2.png
final-topbar-verification.png

# ==========================================
# DATABASE LOCAL FILES
# ==========================================
db/
*.db
*.sqlite

# ==========================================
# BUILD ARTIFACTS & MAPS (cleaned during build)
# ==========================================
*.map
*.tsbuildinfo
.storybook/
storybook-static/
coverage/
.nyc_output/

# ==========================================
# BACKUP FILES
# ==========================================
*.old_backup
*.bak
*.backup
*.tar.gz

# ==========================================
# LARGE MEDIA FILES
# ==========================================
*.mp3
*.wav
*.mp4
*.mov
*.webm
*.ogg

# ==========================================
# MISC
# ==========================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
patterns_for_import.json
.uploads/

# ==========================================
# CI/CD (not needed in container)
# ==========================================
.github/
.gitlab-ci.yml
.circleci/

# ==========================================
# ENVIRONMENT FILES (injected at runtime)
# ==========================================
.env
.env.local
.env.*.local
.mcp/secrets.env
.mcp/logs/

# ==========================================
# KEEP THESE FOR BUILD & RUNTIME:
# - client/          (needed for vite build)
# - public/          (needed for vite build)
# - server/          (Express server source)
# - shared/          (shared types/schemas)
# - scripts/         (build scripts)
# - package.json     (dependencies)
# - package-lock.json (reproducible installs)
# - vite.config.ts   (Vite configuration)
# - tsconfig.json    (TypeScript config)
# - tailwind.config.ts (Tailwind config)
# - postcss.config.js (PostCSS config)
# - drizzle.config.ts (Drizzle ORM config)
# - migrations/      (database migrations)
# ==========================================
